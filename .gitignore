# ============================================================
# Terraform .gitignore
# ============================================================

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (may contain sensitive data)
# Add specific .tfvars files to version control using !
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Generated files
generated-openapi.yaml

# ============================================================
# OS-specific
# ============================================================

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ============================================================
# IDE-specific
# ============================================================

# IntelliJ
.idea/
*.iml
*.iws

# VS Code
.vscode/
*.code-workspace

# Sublime
*.sublime-project
*.sublime-workspace

# ============================================================
# Project-specific
# ============================================================

# Backup files
*.bak
*.backup

# Logs
*.log

# Environment files with secrets
.env
.env.local
